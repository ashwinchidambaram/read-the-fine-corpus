# Read The Fine Corpus — environment variables
#
# Copy this file to .env before running `docker compose up`:
#   cp .env.example .env
#
# Credentials marked CHANGE_ME must be set to non-default values in production.
# This file is committed; .env is gitignored.

# PostgreSQL
POSTGRES_DB=finecorpus
POSTGRES_USER=finecorpus
POSTGRES_PASSWORD=CHANGE_ME

# MinIO (S3-compatible object storage)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=CHANGE_ME
MINIO_BUCKET=finecorpus
